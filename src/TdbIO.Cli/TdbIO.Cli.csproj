<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>TdbIO.Cli</PackageId>
    <Description>Command line tool that reports the structure of Tekla Structures model files, DSTV NC files, templates and reports.</Description>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tdbio</ToolCommandName>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>TdbIO.CommandLine</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TdbIO\TdbIO.csproj" />
    <ProjectReference Include="..\TdbIO.Scene\TdbIO.Scene.csproj" />
    <PackageReference Include="IOViewer" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TdbIO.Tests" />
    <InternalsVisibleTo Include="TdbIO.Scene.Tests" />
  </ItemGroup>

</Project>

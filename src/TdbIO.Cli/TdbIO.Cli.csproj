<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>TdbIO.Cli</PackageId>
    <Description>Command line tool that reads Tekla Structures files (.db1, .db2, .nc1, .tpl, .rpt, .xsr) without Tekla Structures and writes the object model as JSON, IFC, an IOScene scene or an HTML viewer.</Description>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tdbio</ToolCommandName>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>TdbIO.CommandLine</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TdbIO\TdbIO.csproj" />
    <ProjectReference Include="..\TdbIO.Scene\TdbIO.Scene.csproj" />
    <PackageReference Include="IOViewer" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TdbIO.Tests" />
    <InternalsVisibleTo Include="TdbIO.Scene.Tests" />
  </ItemGroup>

</Project>
